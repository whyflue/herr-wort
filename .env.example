# Бот работает только от имени сообщества (паблика): сообщество видно
# собеседнику, личный аккаунт не используется.
# Как получить токен: README.md -> "Работа от имени сообщества".

# Токен сообщества.
VK_GROUP_TOKEN=

# Необязательно: id сообщества (число из адреса vk.com/clubNNNN).
# Если пусто — бот определит сообщество по токену.
VK_GROUP_ID=

# Путь к файлу базы SQLite (по умолчанию bot.db рядом с ботом)
DB_PATH=

# Версия VK API
VK_API_VERSION=5.199

# Пауза между исходящими сообщениями, секунды
SEND_DELAY=0.4
