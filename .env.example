# Режим работы бота:
#   group — от имени сообщества (паблика): имя и аватар сообщества,
#           личный аккаунт нигде не светится. Нужен только VK_GROUP_TOKEN.
#   user  — от имени обычного аккаунта. Нужен VK_TOKEN с правом messages.
# Для учебной апробации рекомендуется group.
BOT_MODE=group

# Токен сообщества (для BOT_MODE=group).
# Как получить: README.md -> "Работа от имени сообщества" -> "Ключ доступа".
VK_GROUP_TOKEN=

# Токен пользователя (для BOT_MODE=user).
# Как получить: README.md -> "Получение токена пользователя".
VK_TOKEN=

# Необязательно: id сообщества (число из адреса vk.com/clubNNNN).
# Если пусто — бот определит сообщество по токену.
VK_GROUP_ID=

# Путь к файлу базы SQLite (по умолчанию bot.db рядом с ботом)
DB_PATH=

# Версия VK API
VK_API_VERSION=5.199

# Пауза между исходящими сообщениями, секунды
SEND_DELAY=0.4
